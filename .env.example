# Variables serveur uniquement : ne jamais utiliser le préfixe VITE_.
# À configurer sur l’hébergeur (Vercel ou Netlify), ou dans .env.local pour Vite.
# Chemin principal : webhook de production n8n et secret partagé avec ce workflow.
# La clé d’administration n8n n’est pas nécessaire au site.
CANDIDATURE_WEBHOOK_URL=
CANDIDATURE_WEBHOOK_SECRET=

# Alternative facultative, utilisée uniquement si les deux variables n8n sont vides.
RESEND_API_KEY=
CANDIDATURE_FROM_EMAIL=
