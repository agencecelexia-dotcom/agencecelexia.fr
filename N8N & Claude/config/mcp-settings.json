{
  "mcpServers": {
    "n8n": {
      "url": "https://n8n.srv1241880.hstgr.cloud",
      "enabled": true,
      "tools": [
        "workflow_create",
        "workflow_update",
        "workflow_delete",
        "workflow_execute",
        "workflow_list"
      ]
    }
  },
  "integrations": {
    "google": {
      "services": ["calendar", "drive", "docs", "gmail"],
      "enabled": true,
      "scopes": [
        "https://www.googleapis.com/auth/calendar",
        "https://www.googleapis.com/auth/drive",
        "https://www.googleapis.com/auth/documents",
        "https://www.googleapis.com/auth/gmail.modify"
      ]
    },
    "notion": {
      "enabled": true,
      "version": "2022-06-28"
    },
    "brevo": {
      "enabled": true,
      "apiVersion": "v3"
    }
  },
  "claude": {
    "workflowCreationMode": "automatic",
    "validateBeforeDeployment": true,
    "testMode": false,
    "autoDocumentation": true,
    "errorHandling": {
      "retryAttempts": 3,
      "notifyOnError": true,
      "fallbackBehavior": "pause"
    }
  }
}
